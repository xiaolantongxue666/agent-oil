{
  "schema_version": 1,
  "scenario_code": "PIPELINE_ABNORMAL_001",
  "task_code": "SIM-PIPE-ABN-001",
  "title": "站场参数异常诊断教学仿真实训",
  "teaching_simulation": true,
  "disclaimer": "本场景为教学仿真：全部压力、流量、液位、设备状态与报警均为模拟编造数据，不对应任何真实站场或真实生产系统；训练动作限于观察、信息获取、判断与教学方案选择，不涉及真实开阀、停泵或远程控制。",
  "position_title": "油气储运站场操作工（教学模拟）",
  "description": "在模拟站场中控画面上，学员按阶段观察工艺参数与设备状态，识别输送泵出口压力下降异常，提交原因诊断、风险判断与教学处置方案，并完成规范运行记录。",
  "difficulty": 3,
  "estimated_minutes": 20,
  "target_abilities": [
    "process_understanding",
    "equipment_recognition",
    "instrument_parameter",
    "abnormal_detection",
    "safety_awareness",
    "standard_recording"
  ],
  "briefing": {
    "situation": "【教学模拟情境】某输油泵站，主输泵 P-101 正常运行。仿真时间第 10 分钟起，出口压力与流量出现持续下降趋势，并伴随报警提示。你是当班学员，请在教师指导下完成一次完整的异常发现与判断流程演练。",
    "objectives": [
      "按正确顺序查看工艺流程图、设备状态与参数趋势",
      "在趋势上标出你认为的异常起始区间",
      "结合液位与报警信息，提交最可能的异常原因",
      "完成风险判断，选择恰当的教学处置方案",
      "按模板填写规范运行记录"
    ],
    "safety_notes": [
      "全部数据为教学模拟编造数据，不代表任何真实站场工况",
      "本训练不连接任何真实设备或控制系统",
      "处置方案仅用于教学讨论，禁止据此操作真实生产系统"
    ]
  },
  "monitor": {
    "time_label": "仿真时间（分钟）",
    "series": [
      {
        "id": "pressure_mpa",
        "label": "主输泵出口压力（模拟）",
        "unit": "MPa",
        "points": [[0, 4.2], [5, 4.2], [10, 4.1], [15, 3.9], [20, 3.1], [25, 2.4], [30, 2.1]]
      },
      {
        "id": "flow_t_h",
        "label": "出站流量（模拟）",
        "unit": "t/h",
        "points": [[0, 320], [5, 318], [10, 315], [15, 300], [20, 255], [25, 190], [30, 150]]
      },
      {
        "id": "temperature_c",
        "label": "泵出口温度（模拟）",
        "unit": "℃",
        "points": [[0, 38], [5, 38.2], [10, 38.1], [15, 38.5], [20, 39.6], [25, 40.2], [30, 40.8]]
      },
      {
        "id": "inlet_level_pct",
        "label": "上游进站罐液位（模拟）",
        "unit": "%",
        "points": [[0, 65], [5, 62], [10, 58], [15, 45], [20, 32], [25, 25], [30, 22]]
      }
    ],
    "devices": [
      {
        "id": "pump-main-01",
        "name": "主输泵 P-101（模拟）",
        "status": "运行中",
        "metrics": {"电机电流": "118 A（正常）", "振动": "偏高（模拟）"}
      },
      {
        "id": "inlet-tank-01",
        "name": "上游进站罐 T-101（模拟）",
        "status": "低液位",
        "metrics": {"液位": "22%（持续下降）"}
      },
      {
        "id": "valve-xv-101",
        "name": "进站阀 XV-101（模拟）",
        "status": "全开",
        "metrics": {"开度": "100%"}
      },
      {
        "id": "valve-xv-201",
        "name": "出站阀 XV-201（模拟）",
        "status": "全开",
        "metrics": {"开度": "98%"}
      }
    ],
    "history": {
      "text": "近 24 小时该泵组无检修记录；上游来量自第 8 分钟（模拟）起逐步减少。",
      "last_normal_range": {"pressure_mpa": [4.0, 4.3], "flow_t_h": [300, 330]}
    },
    "alarms": [
      {"time_min": 18, "level": "高", "code": "LAL-T101", "text": "进站罐 T-101 液位低报警（模拟）"},
      {"time_min": 20, "level": "高", "code": "LALL-P101", "text": "主输泵 P-101 出口压力低低报警（模拟）"}
    ],
    "knowledge_docs": [
      {"id": "doc-cavitation", "title": "泵汽蚀与吸入不足的教学讲解", "summary": "进气罐液位持续下降时，泵入口 available 压力降低，可能出现流量压力同时下降、振动升高、温度缓慢上升的组合特征。"},
      {"id": "doc-record-form", "title": "运行记录规范（教学模板）", "summary": "记录应包含：异常时间与现象、初步判断、已做处置与汇报对象、记录人。语言客观、可追溯。"},
      {"id": "doc-report-chain", "title": "站场异常汇报流程（教学）", "summary": "发现异常→记录参数→汇报值班负责人→按规程执行经授权的操作。学员不得独立执行真实操作。"}
    ]
  },
  "stages": {
    "observe": {
      "title": "观察与信息获取",
      "goal": "查看工艺流程图、设备状态、参数趋势与报警，并标出你认为的异常起始区间。",
      "allowed_event_types": [
        "VIEW_PROCESS_FLOW",
        "VIEW_TREND",
        "VIEW_DEVICE_STATUS",
        "VIEW_HISTORY",
        "VIEW_ALARM",
        "OPEN_KNOWLEDGE",
        "MARK_ABNORMAL_POINT"
      ],
      "actions": [
        {"code": "OBS-PROCESS-FLOW", "event_type": "VIEW_PROCESS_FLOW", "target_type": "diagram", "target_id": "pfd-station", "name": "查看站场工艺流程图", "ability_key": "process_understanding", "points": 6, "critical": false},
        {"code": "OBS-UPSTREAM-DOWNSTREAM", "event_type": "VIEW_PROCESS_FLOW", "target_type": "diagram", "target_id": "segment-up-down", "name": "查看上下游来量与去向关系", "ability_key": "process_understanding", "points": 4, "critical": false},
        {"code": "OBS-KNOW-CAVITATION", "event_type": "OPEN_KNOWLEDGE", "target_type": "knowledge_doc", "target_id": "doc-cavitation", "name": "查看“泵汽蚀与吸入不足”教学资料", "ability_key": "process_understanding", "points": 5, "critical": false},
        {"code": "OBS-PUMP-STATUS", "event_type": "VIEW_DEVICE_STATUS", "target_type": "device", "target_id": "pump-main-01", "name": "查看主输泵 P-101 运行状态", "ability_key": "equipment_recognition", "points": 6, "critical": true},
        {"code": "OBS-INLET-TANK-STATUS", "event_type": "VIEW_DEVICE_STATUS", "target_type": "device", "target_id": "inlet-tank-01", "name": "查看进站罐 T-101 状态", "ability_key": "equipment_recognition", "points": 5, "critical": true},
        {"code": "OBS-VALVE-STATUS", "event_type": "VIEW_DEVICE_STATUS", "target_type": "device", "target_id": "valve-xv-101", "name": "查看进/出站阀状态", "ability_key": "equipment_recognition", "points": 4, "critical": false},
        {"code": "OBS-PRESSURE-TREND", "event_type": "VIEW_TREND", "target_type": "trend", "target_id": "pressure_mpa", "name": "查看出口压力趋势", "ability_key": "instrument_parameter", "points": 6, "critical": true},
        {"code": "OBS-FLOW-TREND", "event_type": "VIEW_TREND", "target_type": "trend", "target_id": "flow_t_h", "name": "查看流量趋势", "ability_key": "instrument_parameter", "points": 4, "critical": true},
        {"code": "OBS-LEVEL-TREND", "event_type": "VIEW_TREND", "target_type": "trend", "target_id": "inlet_level_pct", "name": "查看进站罐液位趋势", "ability_key": "instrument_parameter", "points": 3, "critical": true},
        {"code": "OBS-TEMP-TREND", "event_type": "VIEW_TREND", "target_type": "trend", "target_id": "temperature_c", "name": "查看泵出口温度趋势", "ability_key": "instrument_parameter", "points": 2, "critical": false},
        {"code": "OBS-ALARM-LIST", "event_type": "VIEW_ALARM", "target_type": "alarm_panel", "target_id": "alarm-current", "name": "查看当前报警列表", "ability_key": "abnormal_detection", "points": 4, "critical": true},
        {"code": "OBS-MARK-ANOMALY", "event_type": "MARK_ABNORMAL_POINT", "target_type": "trend", "target_id": "pressure_mpa", "name": "在出口压力趋势上标出异常起始区间", "ability_key": "abnormal_detection", "points": 8, "critical": true, "answer": {"target_id": "pressure_mpa", "window_min": 15, "window_max": 30}}
      ],
      "gate": {
        "min_events": 5,
        "required_event_types": ["VIEW_TREND", "VIEW_ALARM", "MARK_ABNORMAL_POINT"]
      },
      "hint_templates": [
        "可以先比较异常发生前后的参数趋势，再看设备状态是否一致。",
        "压力下降时，注意流量与上游液位是否同步变化。",
        "报警列表往往提示了参数之间的关联。"
      ]
    },
    "diagnose": {
      "title": "提交异常诊断",
      "goal": "根据观察结果，选择最可能的异常原因。",
      "allowed_event_types": ["SUBMIT_DIAGNOSIS"],
      "question": "根据模拟参数变化，主输泵出口压力与流量持续下降的最可能原因是？",
      "event_code": "SUBMIT-DIAGNOSIS",
      "ability_key": "abnormal_detection",
      "actions": [
        {"code": "SUBMIT-DIAGNOSIS", "name": "提交异常诊断", "ability_key": "abnormal_detection", "points": 8, "critical": true}
      ],
      "options": [
        {"code": "D1", "text": "仪表随机漂移，实际工况并未变化", "score": 0, "error_type": "wrong_cause"},
        {"code": "D2", "text": "上游进站罐液位持续下降导致吸入不足，泵处于低入口条件运行", "score": 8, "correct": true},
        {"code": "D3", "text": "主输泵电机跳闸停机", "score": 0, "error_type": "cause_not_checked"},
        {"code": "D4", "text": "下游管线发生穿孔泄漏", "score": 0, "error_type": "wrong_cause"}
      ],
      "gate": {"min_events": 1, "required_event_types": ["SUBMIT_DIAGNOSIS"]},
      "hint_templates": [
        "逐一核对每个候选原因与电机电流、阀位、上下游参数的相容性。",
        "如果电机仍在正常运行且电流正常，哪一类原因可以排除？"
      ]
    },
    "risk_assess": {
      "title": "风险判断",
      "goal": "判断当前工况下最需要优先关注的安全风险。",
      "allowed_event_types": ["SUBMIT_RISK_ASSESSMENT"],
      "question": "在该模拟工况下（若为真实生产），最需要优先判断的教学结论是？",
      "event_code": "SUBMIT-RISK",
      "ability_key": "safety_awareness",
      "actions": [
        {"code": "SUBMIT-RISK", "name": "提交风险判断", "ability_key": "safety_awareness", "points": 10, "critical": true}
      ],
      "options": [
        {"code": "R1", "text": "吸入不足可能导致泵组汽蚀损坏，属于需要尽快干预的升级风险", "score": 10, "correct": true},
        {"code": "R2", "text": "无风险，维持常规监护即可", "score": 0, "error_type": "risk_ignored"},
        {"code": "R3", "text": "应立即按重大事故响应全站紧急停车", "score": 2, "error_type": "overreaction"},
        {"code": "R4", "text": "仅影响计量外观数据，对设备安全没有影响", "score": 0, "error_type": "risk_ignored"}
      ],
      "gate": {"min_events": 1, "required_event_types": ["SUBMIT_RISK_ASSESSMENT"]},
      "hint_templates": [
        "风险判断要同时考虑“是否会损伤设备”和“干预的紧迫程度”。",
        "对比报警等级与参数变化速率，判断风险升级速度。"
      ]
    },
    "decision": {
      "title": "选择教学处置方案",
      "goal": "从教学方案中选择最恰当的处理方式（仅为教学训练，不涉及真实操作指令）。",
      "allowed_event_types": ["SUBMIT_DECISION"],
      "question": "教学演练中，发现上述模拟工况后最恰当的处置方案是？",
      "event_code": "SUBMIT-DECISION",
      "ability_key": "safety_awareness",
      "actions": [
        {"code": "SUBMIT-DECISION", "name": "提交处置方案", "ability_key": "safety_awareness", "points": 10, "critical": true}
      ],
      "options": [
        {"code": "T1", "text": "自行提高泵转速强行抬升出口压力", "score": 0, "error_type": "unsafe_decision"},
        {"code": "T2", "text": "记录并复核模拟参数后，汇报值班负责人，按教学预案评估降负荷或切换备用泵，并通知上游核实来量", "score": 10, "correct": true},
        {"code": "T3", "text": "继续观察，等待报警自动复归", "score": 0, "error_type": "delay_response"},
        {"code": "T4", "text": "直接关小出口阀以抬高压力表读数", "score": 0, "error_type": "unsafe_decision"}
      ],
      "gate": {"min_events": 1, "required_event_types": ["SUBMIT_DECISION"]},
      "hint_templates": [
        "处置方案要符合“先确认、再汇报、后操作”的教学流程。",
        "哪一项既控制了风险升级，又符合学员的权限边界？"
      ]
    },
    "record": {
      "title": "填写规范记录",
      "goal": "按模板完整填写一条规范运行记录。",
      "allowed_event_types": ["SUBMIT_RECORD"],
      "event_code": "SUBMIT-RECORD",
      "ability_key": "standard_recording",
      "actions": [
        {"code": "SUBMIT-RECORD", "name": "提交规范记录", "ability_key": "standard_recording", "points": 15, "critical": true}
      ],
      "required_fields": ["time_phenomenon", "observed_data", "preliminary_cause", "actions_taken", "recorder"],
      "field_templates": {
        "time_phenomenon": "异常发生时间与现象（仿真时间与主要现象）",
        "observed_data": "观察到的关键参数（如压力/流量/液位数值）",
        "preliminary_cause": "初步判断及依据",
        "actions_taken": "已做处置与汇报对象",
        "recorder": "记录人署名"
      },
      "gate": {"min_events": 1, "required_event_types": ["SUBMIT_RECORD"]},
      "hint_templates": [
        "规范记录要求：时间明确、数据具体、依据可追溯、处置与汇报对象完整。"
      ]
    }
  },
