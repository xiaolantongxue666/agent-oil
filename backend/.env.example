# ============================================================
# 油训智安 后端环境变量样例
# 复制为 .env 并按实际填写。生产环境务必通过系统环境变量注入，勿提交真实 Key。
# ============================================================

# ---- 应用 ----
APP_ENV=development
APP_NAME=油训智安
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173

# ---- 数据库 ----
# 生产：PostgreSQL；本地无 Docker 时可用 SQLite 兜底：sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://oiltrain:oiltrain123@localhost:5432/oiltrain

# ---- JWT ----
# 生产必须改为长随机串
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================
# 阿里云百炼（通义千问）LLM —— 仅后端使用，严禁下发前端/写入日志
# 未填写 BAILIAN_API_KEY 或置 LLM_USE_MOCK=true 时，自动回退 Mock Provider
# 系统仍可端到端运行（离线演示），但 LLM 输出为教学模拟内容
# ============================================================
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
BAILIAN_TEMPERATURE=0.2
BAILIAN_TIMEOUT=60
BAILIAN_MAX_RETRIES=3
LLM_USE_MOCK=true

# ---- Qdrant 向量库 ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=oil_train_safe
QDRANT_API_KEY=

# ---- Embedding（BGE-M3）----
# local：本地 sentence-transformers；api：调用在线 Embedding
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=1024

# ---- Reranker（BGE-Reranker）----
RERANKER_BACKEND=local
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_API_KEY=
RERANKER_BASE_URL=

# ---- RAG ----
RAG_RETRIEVE_TOP_K=20
RAG_RERANK_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_MIN_RELEVANCE=0.3

# ---- 实训 ----
MAX_TRAINING_FOLLOW_UPS=3
STRUCTURED_OUTPUT_MAX_RETRIES=2

# ---- 混合评分权重（和为 1.0）----
EVAL_RULE_WEIGHT=0.4
EVAL_SEMANTIC_WEIGHT=0.3
EVAL_LLM_WEIGHT=0.3

# ---- 六维能力权重（和为 1.0）----
ABILITY_WEIGHT_PROCESS=0.20
ABILITY_WEIGHT_EQUIPMENT=0.15
ABILITY_WEIGHT_INSTRUMENT=0.15
ABILITY_WEIGHT_ABNORMAL=0.20
ABILITY_WEIGHT_SAFETY=0.20
ABILITY_WEIGHT_RECORDING=0.10
