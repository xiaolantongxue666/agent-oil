# =============================================================================
# 油训智安 OilTrainSafe - 环境变量示例
# 复制为 .env 并填写真实值。.env 不得提交到 Git。
# =============================================================================

# ---- 应用 ----
APP_ENV=development
APP_NAME=油训智安
APP_PORT=8000
APP_DEBUG=true
# CORS 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- 数据库 PostgreSQL ----
DATABASE_URL=postgresql+asyncpg://oiltrain:oiltrain123@localhost:5432/oiltrain
PG_HOST=localhost
PG_PORT=5432
PG_USER=oiltrain
PG_PASSWORD=oiltrain123
PG_DB=oiltrain

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 阿里云百炼 (Qwen) ----
# 重要：API Key 仅存于此文件，不进入 Git、不发给前端、不写入日志
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
BAILIAN_TEMPERATURE=0.2
BAILIAN_TIMEOUT=60
BAILIAN_MAX_RETRIES=3
# 无 API Key 时是否使用 Mock LLM（保证非 AI 链路可运行）
LLM_USE_MOCK=true

# ---- Qdrant 向量库 ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=oil_train_safe
QDRANT_API_KEY=

# ---- Embedding ----
# local=本地 sentence-transformers 模型；api=调用百炼/OpenAI兼容 embedding 服务
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=1024

# ---- Reranker ----
# local=本地模型；api=调用已授权的远程重排服务
RERANKER_BACKEND=local
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_API_KEY=
RERANKER_BASE_URL=

# ---- 文件上传与解析（2GB 服务器建议） ----
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,txt,md,markdown
DOCUMENT_MAX_PAGES=60
DOCUMENT_MAX_TEXT_CHARS=120000
DOCUMENT_MAX_ARCHIVE_ENTRIES=2000
DOCUMENT_MAX_UNCOMPRESSED_BYTES=30000000
DOCUMENT_MAX_COMPRESSION_RATIO=100

# ---- 岗位公开数据发现（使用公开搜索结果，教师审核后才发布） ----
JOB_SEARCH_URL=https://cn.bing.com/search
JOB_SEARCH_TIMEOUT=20
JOB_SEARCH_MAX_RESULTS=20
POSITION_BROWSER_HEADLESS=true
POSITION_BROWSER_MAX_STEPS=24
POSITION_BROWSER_MAX_PAGES=12
POSITION_BROWSER_TIMEOUT_SECONDS=30
POSITION_BROWSER_MIN_INTERVAL_SECONDS=1.5
POSITION_BROWSER_SOURCE_TIMEOUT_SECONDS=180

# ---- RAG 参数 ----
RAG_RETRIEVE_TOP_K=20
RAG_RERANK_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_MIN_RELEVANCE=0.3

# ---- 结构化输出 ----
STRUCTURED_OUTPUT_MAX_RETRIES=2

# ---- 混合评分权重（和为 1.0）----
EVAL_RULE_WEIGHT=0.4
EVAL_SEMANTIC_WEIGHT=0.3
EVAL_LLM_WEIGHT=0.3
# 六维能力默认权重（和为 1.0）
ABILITY_WEIGHT_PROCESS=0.20
ABILITY_WEIGHT_EQUIPMENT=0.15
ABILITY_WEIGHT_INSTRUMENT=0.15
ABILITY_WEIGHT_ABNORMAL=0.20
ABILITY_WEIGHT_SAFETY=0.20
ABILITY_WEIGHT_RECORDING=0.10
